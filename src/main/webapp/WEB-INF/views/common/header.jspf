<%-- Shared page header + navbar.
     The including page must declare the JSTL core taglib (prefix c) and set "pageTitle" first. --%>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}" /> | RecipeShare</title>

  <script>
    // Apply the saved theme BEFORE the page paints (prevents a light flash in dark mode)
    (function () {
      try { document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('theme') || 'light'); }
      catch (e) { document.documentElement.setAttribute('data-bs-theme', 'light'); }
    })();
  </script>

  <!-- Fonts: Playfair Display (headings) + Poppins (body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 + Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="${ctx}/css/style.css" rel="stylesheet">
  <script>
    // If a recipe photo fails to load (offline, broken link), show the icon placeholder instead
    function imgFallback(img) {
      var d = document.createElement('div');
      d.className = 'recipe-placeholder';
      d.innerHTML = '<i class="bi bi-egg-fried"></i>';
      img.replaceWith(d);
    }
  </script>
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg site-nav sticky-top">
  <div class="container">
    <a class="navbar-brand" href="${ctx}/home">
      <span class="brand-icon"><i class="bi bi-egg-fried"></i></span>
      <div>Recipe<span>Share</span></div>
    </a>
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-list fs-2"></i>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link ${pageTitle == 'Home' ? 'active' : ''}" href="${ctx}/home">Home</a></li>
        <li class="nav-item"><a class="nav-link ${pageTitle == 'Browse Recipes' ? 'active' : ''}" href="${ctx}/recipes">Browse Recipes</a></li>
      </ul>
      <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mt-3 mt-lg-0">
        <button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode"><i class="bi bi-moon-stars-fill"></i></button>
        <c:choose>
          <c:when test="${not empty sessionScope.user}">
            <span class="nav-avatar d-none d-lg-inline-flex" title="<c:out value='${sessionScope.user.name}' />">
              <c:out value="${fn:toUpperCase(fn:substring(sessionScope.user.name, 0, 1))}" />
            </span>
            <span class="me-lg-2">Hi, <strong><c:out value="${sessionScope.user.name}" /></strong></span>
            <a class="btn btn-outline-brand btn-sm" href="${ctx}${sessionScope.user.dashboardPath}"><i class="bi bi-grid-1x2-fill me-1"></i>Dashboard</a>
            <a class="btn btn-brand btn-sm" href="${ctx}/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
          </c:when>
          <c:otherwise>
            <a class="btn btn-outline-brand btn-sm" href="${ctx}/login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
            <a class="btn btn-brand btn-sm" href="${ctx}/register"><i class="bi bi-person-plus-fill me-1"></i>Sign Up</a>
          </c:otherwise>
        </c:choose>
      </div>
    </div>
  </div>
</nav>
